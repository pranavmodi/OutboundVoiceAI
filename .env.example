# Backend
OPENAI_API_KEY=sk-your-key-here
BACKEND_PORT=8000

# Optional: Twilio (for real phone calls)
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM_NUMBER=+1...
# ALLOW_TWILIO_CALLS=true

# Optional: CORS origins (comma-separated, defaults to localhost:3000)
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_PORT=3000

# Email notifications
# EMAIL_NOTIFICATION_RECIPIENT=scheduling@precisemri.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=...
# SMTP_PASSWORD=...
# SMTP_FROM_EMAIL=...

# SMS
# PRECISE_CALLBACK_NUMBER=800-558-2223
# PRECISE_MAIN_NUMBER=

# Daily Slack report (yesterday's call summary posted to a webhook once per day)
# SLACK_DAILY_REPORT_ENABLED=false
# SLACK_DAILY_REPORT_WEBHOOK_URL=https://hooks.slack.com/services/...
# SLACK_DAILY_REPORT_HOUR=7
# SLACK_DAILY_REPORT_TIMEZONE=America/Los_Angeles

# Database
# DATABASE_URL=postgresql://precise:password@localhost:5432/outboundvoice

# RadFlow CallListData API (live patient source)
# CALLLIST_API_URL=https://app.radflow360.com/chatbotapi/Patient/CallListData
# CALLLIST_API_USER=Chatbot
# CALLLIST_API_PASSWORD=...

# FreePBX transfer configuration
# Language code → FreePBX scheduling queue ID
# LANGUAGE_QUEUE_MAP={"en":"9006","es":"9009","zh":"9012"}
# FreePBX queue ID → SIP transfer destination (sip:QUEUEID@host;transport=TLS)
# QUEUE_TRANSFER_TARGETS={"9006":"sip:9006@pbx.radflow360.com;transport=TLS","9009":"sip:9009@pbx.radflow360.com;transport=TLS","9012":"sip:9012@pbx.radflow360.com;transport=TLS","9013":"sip:9013@pbx.radflow360.com;transport=TLS"}
# Only aggregate these queues for gating decisions (comma-separated; empty = all)
# MONITORED_QUEUES=9006,9009,9012,9013

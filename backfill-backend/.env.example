# Cancellation Backfill backend — local config

# Listen port (kept distinct from the outbound caller's 8000)
BACKFILL_BACKEND_PORT=8001

# Backfill agent has its own database — DO NOT point this at the outbound caller's DB.
# Same physical postgres server as the outbound caller is OK (architecture requires
# separate logical database, not separate server). For dev against the team's remote
# postgres at 10.254.99.34, use the precise/password creds and the `backfill` database:
#   postgresql+asyncpg://precise:password@10.254.99.34:5432/backfill
# For a fully local setup, point this at your local postgres with a freshly created
# `backfill` database.
BACKFILL_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/backfill

# CORS — comma-separated origins permitted to call this backend.
# Add your frontend dev URL if it binds to a non-default port (Next.js falls
# back to 3001/3002/etc when 3000 is in use).
BACKFILL_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002,http://127.0.0.1:3003

# RadFlow cancellation webhook (production + local curl tests)
RADFLOW_WEBHOOK_ENABLED=true
RADFLOW_WEBHOOK_TOKEN=dev-change-me

# Dev appointment simulator — set false in production
BACKFILL_SIMULATOR_ENABLED=true
